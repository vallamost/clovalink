# ClovaLink Native Deployment Configuration
# Copy this file to /opt/clovalink/backend/.env and customize

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Security - Generate with: openssl rand -base64 48 | tr -d '/+=' | head -c 64
JWT_SECRET=CHANGE-ME-generate-a-64-character-random-string-here

# Database - Update password to match your PostgreSQL setup
DATABASE_URL=postgres://clovalink:CHANGE-ME-your-db-password@localhost:5432/clovalink

# Redis - Default local Redis instance
REDIS_URL=redis://localhost:6379

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# Storage type: "local" or "s3"
STORAGE_TYPE=local

# For local storage
UPLOAD_DIR=/opt/clovalink/backend/uploads

# Local Storage Encryption (recommended for production)
# Generate with: openssl rand -base64 32
# WARNING: Keep this key safe! Losing it means losing access to encrypted files.
# ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# For S3 storage (uncomment and configure if using S3)
# STORAGE_TYPE=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# USE_PRESIGNED_URLS=true

# S3-compatible storage (Wasabi, MinIO, etc.)
# S3_ENDPOINT=https://s3.wasabisys.com
# S3_PATH_STYLE=true  # Required for MinIO

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=production

# Logging level: error, warn, info, debug, trace
RUST_LOG=info

# Server settings
HOST=127.0.0.1
PORT=3000

# Base URL for share links and email notifications
# Update this to your actual domain or IP
BASE_URL=http://localhost:8080

# CORS allowed origins (comma-separated for multiple)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ============================================================================
# DATABASE CONNECTION POOL
# ============================================================================

DB_MAX_CONNECTIONS=50
DB_MIN_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800

# ============================================================================
# TRANSFER & PERFORMANCE
# ============================================================================

# Transfer scheduler configuration
TRANSFER_SMALL_CONCURRENT=50
TRANSFER_MEDIUM_CONCURRENT=20
TRANSFER_LARGE_CONCURRENT=5
TRANSFER_LARGE_BANDWIDTH_MBPS=50

# Request handling
REQUEST_TIMEOUT_SECS=300
MAX_CONCURRENT_REQUESTS=1000
PER_IP_REQUESTS_PER_SEC=100
PER_IP_BURST_SIZE=200

# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECS=30

# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# ClamAV Virus Scanning
# Install: sudo apt-get install clamav clamav-daemon
# CLAMAV_ENABLED=true
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000
# CLAMAV_WORKERS=4
# CLAMAV_MAX_FILE_SIZE_MB=100
# CLAMAV_MAX_QUEUE_SIZE=10000

# S3 Replication (for disaster recovery)
# REPLICATION_ENABLED=true
# REPLICATION_ENDPOINT=https://s3.us-west-2.amazonaws.com
# REPLICATION_BUCKET=clovalink-backup
# REPLICATION_REGION=us-west-2
# REPLICATION_ACCESS_KEY=your-access-key
# REPLICATION_SECRET_KEY=your-secret-key
# REPLICATION_MODE=backup  # backup = uploads only, mirror = uploads + deletes
# REPLICATION_RETRY_SECONDS=60
# REPLICATION_WORKERS=4

# Email Notifications (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_FROM_NAME=ClovaLink

# AI Features (OpenAI, Anthropic, or self-hosted)
# AI_PROVIDER=openai
# AI_API_KEY=your-api-key
# AI_MODEL=gpt-4
# AI_MAX_TOKENS=4000
# AI_TEMPERATURE=0.7

# ============================================================================
# SECURITY NOTES
# ============================================================================

# File permissions: chmod 600 /opt/clovalink/backend/.env
# Owner: chown clovalink:clovalink /opt/clovalink/backend/.env
#
# Never commit this file to version control!
# Keep backups of JWT_SECRET and ENCRYPTION_KEY in a secure location.
